# Backend environment (copy values into backend/.env — do not commit secrets)

# QuickBooks Online — DEVELOPMENT / SANDBOX (Phase 1)
# Intuit Developer app: NLM-app
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# Must exactly match a Redirect URI registered on the Intuit app
QBO_REDIRECT_URI=http://localhost:4000/api/integrations/quickbooks/callback

# Where to send the browser after OAuth (never put tokens in these URLs)
QBO_FRONTEND_SUCCESS_URL=http://localhost:5173/accounting/invoices?qbo=connected
QBO_FRONTEND_ERROR_URL=http://localhost:5173/accounting/invoices?qbo=error

# Optional legacy fallback only — prefer OAuth connect (tokens persist in Mongo)
# QBO_REFRESH_TOKEN=
# QBO_REALM_ID=

# Slack Incoming Webhook for accounting invoice alerts (later)
# SLACK_INVOICE_WEBHOOK_URL=

# Optional cron (default 8:00 AM America/New_York)
# INVOICE_ALERT_CRON=0 8 * * *
