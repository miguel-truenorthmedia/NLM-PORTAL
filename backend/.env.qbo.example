# Backend environment (copy values into backend/.env — do not commit secrets)

# --- existing portal vars omitted ---

# QuickBooks Online — invoice due alerts
# Create an Intuit Developer app, connect your QBO company, then paste:
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# sandbox | production
QBO_ENVIRONMENT=sandbox

# Slack Incoming Webhook for accounting invoice alerts
SLACK_INVOICE_WEBHOOK_URL=

# Optional cron (default 8:00 AM America/New_York)
# INVOICE_ALERT_CRON=0 8 * * *
