# Copy to nlmAPI/.env or rely on ../backend/.env

RINGBA_ACCOUNT_ID=
RINGBA_API_TOKEN=

# Optional password grant fallback
# RINGBA_USERNAME=
# RINGBA_PASSWORD=

# Block when inbound number has this many calls (or more) today (ET)
NUMBER_BLOCKER_THRESHOLD=3

# true = log candidates only, do not POST blockedNumbers
NUMBER_BLOCKER_DRY_RUN=false

# Bi-monthly blocked-number reset (2nd + 16th @ 8 AM ET via schedules.config.js)
# Slack webhook for reset notifications (optional until you provide it)
SLACK_RINGBA_WEBHOOK_URL=

# Campaign drop-rate alerts (nlmDropRate.js — every 30m, 9–6 ET)
SLACK_DROP_RATE_WEBHOOK_URL=
# DROP_RATE_MIN_TOTAL_CALLS=20
# DROP_RATE_WINDOW_MINUTES=30
# DROP_RATE_DRY_RUN=false

# Optional: parallel DELETE workers (default 5)
# BLOCKED_RESET_CONCURRENCY=5

# true = plan only, no deletes
# BLOCKED_RESET_DRY_RUN=false
